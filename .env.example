# Application Configuration
APP_NAME=KnowledgeFlow RAG
APP_ENV=development

# Google Gemini LLM & Embeddings (Optional for Phase 0/1)
GEMINI_API_KEY=
GEMINI_ROUTER_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_MODEL=gemini-3.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Document Chunking Configuration
CHUNK_SIZE=500
CHUNK_OVERLAP=50

# Vector Store & Semantic Retrieval Configuration
EMBEDDING_DIMENSION=768
RETRIEVAL_TOP_K=4
VECTORSTORE_DIR=vectorstore

# RAG Generation & Grounding Configuration (Phase 3)
RAG_MIN_SIMILARITY=0.60
LLM_TEMPERATURE=1.0
